	partition DimDate = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS (
				    CALENDAR (
				        MIN ( property_performance[BusinessDate] ),
				        MAX ( property_performance[BusinessDate] )
				    ),
				    "Year", YEAR ( [Date] ),
				    "MonthNumber", MONTH ( [Date] ),
				    "MonthName", FORMAT ( [Date], "MMM" ),
				    "Quarter", "Q" & FORMAT ( [Date], "Q" ),
				    "YearMonth", FORMAT ( [Date], "YYYY-MM" )
				)
				
				```

	annotation PBI_Id = 42f4eabb2d5b465eaebb79f1005445c4

