	measure 'Occupancy Today' = ```
			
			DIVIDE(
			    CALCULATE(SUM('property_performance'[soldCount]), 'property_performance'[BusinessDate] = TODAY()),
			    CALCULATE(SUM('property_performance'[houseCount]), 'property_performance'[BusinessDate] = TODAY())
			) 
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 1059db0a-472e-4e07-8dfa-6eb7d76bd4c9

	measure 'Occupancy MTD' = ```
			
			DIVIDE(
			    CALCULATE(SUM('property_performance'[soldCount]), DATESMTD('Date'[Date])),
			    CALCULATE(SUM('property_performance'[houseCount]), DATESMTD('Date'[Date]))
			) 
			```
		formatString: 0.00%;-0.00%;0.00%
