	measure Tentatively_blockedToday =
			
			VAR SelectedDate =
			    MAX ( 'Date'[Date] )   -- picks selected date (or BLANK if none)
			RETURN
			CALCULATE (
			    [Tentatively_blocked],
			    'Date'[Date] =
			        IF (
			            ISBLANK ( SelectedDate ),
			            TODAY(),          -- if no date selected → today
			            SelectedDate      -- if date selected → that date
			        )
			)
		formatString: 0
		lineageTag: 6f19effa-e93d-4ee6-a6e9-e6c752aa9be5

